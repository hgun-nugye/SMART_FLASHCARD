<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/widgetTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Word of the Day / Từ vựng hôm nay"
        android:textColor="#1D93D2"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widgetWord"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Spaced Repetition"
        android:textColor="#3A3A3A"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widgetMeaning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Phương pháp lặp lại ngắt quãng"
        android:textColor="#666666"
        android:textSize="14sp" />

    <Button
        android:id="@+id/btnRefreshWidget"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="4dp"
        android:textSize="12sp"
        android:text="Đổi từ / Next" />
</LinearLayout>